{
  "expo": {
    "name": "Girogirotondo",
    "slug": "girogirotondo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "it.girogirotondo.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "it.girogirotondo.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker"
    ]
  }
}
